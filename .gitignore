# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Local machine config (contains your SDK path)
local.properties

# Android Studio
.idea/
*.iml

# Built APKs (rebuild with ./gradlew assembleDebug)
*.apk
*.aab

# Signing keys: never commit these
*.jks
*.keystore
